        },
        "colorMode": "background"
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Task Activity Rate",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(tasks_created_total{job=~\"$job\"}[5m]))",
          "legendFormat": "Created",
          "refId": "A"
        },
        {
          "expr": "sum(rate(tasks_completed_total{job=~\"$job\"}[5m]))",
          "legendFormat": "Completed",
          "refId": "B"
        },
        {
          "expr": "sum(rate(tasks_deleted_total{job=~\"$job\"}[5m]))",
          "legendFormat": "Deleted",
