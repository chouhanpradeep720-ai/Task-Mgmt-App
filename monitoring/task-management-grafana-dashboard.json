      "type": "stat",
      "title": "Running Pods",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 60
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{namespace=\"$namespace\",phase=\"Running\"})",
