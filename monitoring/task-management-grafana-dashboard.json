        "w": 12,
        "x": 0,
        "y": 65
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
