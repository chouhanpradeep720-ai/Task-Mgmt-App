    {
      "id": 28,
      "type": "row",
      "title": "📜 Loki Application Logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 73
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 29,
      "type": "logs",
      "title": "Backend Live Logs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 74
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "{namespace=\"$namespace\", container=\"backend\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLines": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "id": 30,
      "type": "logs",
      "title": "🔥 Errors & Warnings",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 86
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "{namespace=\"$namespace\"} |~ \"(?i)(error|exception|fatal|panic|warn|failed)\"",
          "refId": "A"
