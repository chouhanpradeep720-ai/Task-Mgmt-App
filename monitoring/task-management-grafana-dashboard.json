    {
      "id": 19,
      "type": "row",
      "title": "🗄️ PostgreSQL / RDS Connection Pool",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "DB Pool Connections",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(db_pool_total{job=~\"$job\"})",
          "legendFormat": "Total",
          "refId": "A"
        },
        {
          "expr": "sum(db_pool_active{job=~\"$job\"})",
          "legendFormat": "Active",
          "refId": "B"
        },
        {
          "expr": "sum(db_pool_idle{job=~\"$job\"})",
          "legendFormat": "Idle",
          "refId": "C"
        },
        {
          "expr": "sum(db_pool_waiting{job=~\"$job\"})",
          "legendFormat": "Waiting",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Database Query Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
